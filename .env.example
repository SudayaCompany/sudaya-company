# Salin ke .env.local (sudah di-ignore git), lalu isi dari Supabase Dashboard.
# Jangan pernah commit .env.local.

# --- Public: aman dipakai di browser -----------------------------------------
# Project Settings → API → Project URL, tanpa path (bukan .../rest/v1/)
# Contoh bentuk: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys → publishable key (sb_publishable_...) atau anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only: JANGAN beri prefix NEXT_PUBLIC_ ----------------------------
# Project Settings → API Keys → secret key (sb_secret_...) atau service_role key.
# Melewati RLS — hanya boleh dipakai di server.
SUPABASE_SERVICE_ROLE_KEY=

# Connect (tombol di header dashboard) → Connection string.
# Dipakai oleh app (src/db) dan drizzle-kit (npm run db:migrate).
#
# Lokal & migrasi: pakai "Session pooler" (IPv4, port 5432):
#   postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# "Direct connection" (db.<project-ref>.supabase.co) hanya IPv6 — sering
# tidak bisa diakses dari jaringan rumah/kantor tanpa IPv6.
# Di Vercel boleh diisi "Transaction pooler" (port 6543) untuk runtime serverless.
#
# Jika password mengandung karakter khusus (@ : / ? # [ ] %), encode dulu
# (mis. @ → %40), atau reset password database ke alfanumerik.
DATABASE_URL=
